{
  "name": "windlass",
  "version": "0.1.0",
  "description": "Pipelines as typed graphs with verifier edges and human gates, run by a runner with no model inside it, every run replayable in the browser.",
  "type": "module",
  "bin": {
    "windlass": "bin/windlass.mjs"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "examples",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node src/runner.mjs --selftest && node --test tests/viewer.test.mjs tests/redaction.test.mjs tests/no-model.test.mjs tests/site.test.mjs",
    "selftest": "node src/runner.mjs --selftest",
    "build:site": "node bin/build-site.mjs",
    "build:assets": "node bin/build-assets.mjs"
  },
  "license": "MIT",
  "author": "James Lorenz Santos",
  "dependencies": {},
  "devDependencies": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamessuuu/windlass.git"
  },
  "homepage": "https://windlass-runner.vercel.app/",
  "bugs": {
    "url": "https://github.com/jamessuuu/windlass/issues"
  },
  "exports": {
    ".": "./src/runner.mjs",
    "./viewer": "./src/viewer.mjs"
  },
  "sideEffects": false
}
